{
  "name": "xrplean-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node server.ts --dev",
    "start": "node server.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:backend": "python3 ../tests/frontend.py",
    "format": "prettier --write src dev server.ts tests playwright.config.ts vite.config.ts",
    "test:speculos": "node tests/speculos-connect.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@xrpl-commons/xrpl-connect-react": "1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xrpl": "^4.6.0",
    "xrpl-connect": "1.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@ledgerhq/hw-app-xrp": "^6.38.0",
    "@ledgerhq/hw-transport": "^6.36.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "buffer": "^6.0.3",
    "prettier": "^3.9.10",
    "ripple-keypairs": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
