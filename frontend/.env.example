# Public application key, never the Xaman API secret. Rebuild after changing.
VITE_XAMAN_API_KEY=
VITE_XAMAN_RETURN_URL=http://localhost:4173/
# Wallet discovery network is separate from XLB's configured target.
VITE_WALLET_NETWORK=mainnet
# Optional private server setting (never sent to the browser):
XL_UI_BACKEND=http://127.0.0.1:4001
